{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stocklayer.example/schemas/news-sentiment-site-summary-v1.json",
  "title": "StockLayer homepage news sentiment feed",
  "type": "object",
  "required": [
    "schemaVersion",
    "methodologyVersion",
    "universe",
    "joinKey",
    "generatedAt",
    "asOfDate",
    "companyCount",
    "companies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "methodologyVersion": { "type": "string" },
    "universe": { "const": "uk-100" },
    "joinKey": { "const": "slug" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "asOfDate": { "type": "string", "format": "date" },
    "companyCount": { "type": "integer", "minimum": 1 },
    "companies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "companyName",
          "ticker",
          "slug",
          "date",
          "dailyScore",
          "dailyLabel",
          "rollingScore",
          "confidence",
          "confidenceBand",
          "coverageStatus",
          "storyCount",
          "sourceCount",
          "changeFromPreviousScoredDay",
          "flags"
        ],
        "properties": {
          "companyName": { "type": "string" },
          "ticker": { "type": "string" },
          "slug": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "dailyScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "dailyLabel": { "type": "string" },
          "rollingScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidenceBand": { "enum": ["low", "medium", "high"] },
          "coverageStatus": { "enum": ["ok", "no_coverage", "provider_error"] },
          "storyCount": { "type": "integer", "minimum": 0 },
          "sourceCount": { "type": "integer", "minimum": 0 },
          "changeFromPreviousScoredDay": { "type": ["number", "null"] },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "direction", "severity", "status"],
              "properties": {
                "type": { "type": "string" },
                "direction": { "enum": ["positive", "negative", "neutral", "mixed"] },
                "severity": { "enum": ["low", "medium", "high", "critical"] },
                "status": { "enum": ["possible", "confirmed", "calculated"] },
                "detail": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
